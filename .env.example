# AtlaSent environment variables
# Copy this file to .env, fill in real values, and source it before running examples.
#
# NEVER commit a .env file with real credentials to version control.

# Your AtlaSent API key. Create one in the console under Settings → API Keys.
# Live keys start with ask_live_ (production); test keys start with ask_test_ (non-billable).
ATLASENT_API_KEY=ask_test_REPLACE_ME

# Base URL for the AtlaSent API. Must end in /functions/v1 — examples append
# paths such as /v1-evaluate directly to it. (Some examples read ATLASENT_BASE_URL.)
ATLASENT_API_URL=https://api.atlasent.io/functions/v1

# Your AtlaSent organisation ID. Find it under Settings → Organisation.
ATLASENT_ORG_ID=org_replace_me

# ── browser-guard only ─────────────────────────────────────────────────────
# Vite exposes only variables prefixed with VITE_ to the browser bundle.
# Copy the values above with the VITE_ prefix for the browser-guard example.
VITE_ATLASENT_API_KEY=ask_test_REPLACE_ME
VITE_ATLASENT_API_URL=https://api.atlasent.io/functions/v1
VITE_ATLASENT_ORG_ID=org_replace_me
