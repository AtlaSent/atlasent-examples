# AtlaSent environment variables for behavior events demo.
# Copy to .env, fill in real values, and source before running.
#
# NEVER commit a .env file with real credentials to version control.

ATLASENT_API_KEY=ask_replace_me
ATLASENT_API_URL=https://api.atlasent.io/functions/v1
ATLASENT_ORG_ID=org_replace_me

# Webhook URL for behavior event decision notifications (optional).
BEHAVIOR_WEBHOOK_URL=https://your-analytics-system.example/webhooks
ATLASENT_WEBHOOK_SECRET=replace_me
