# AtlaSent environment variables for GxP batch record release demo.
# Copy to .env, fill in real values, and source before running.
#
# NEVER commit a .env file with real credentials to version control.

# Your AtlaSent API key. Create one in the console under Settings → API Keys.
ATLASENT_API_KEY=ask_replace_me

# Base URL for the AtlaSent API.
ATLASENT_API_URL=https://api.atlasent.io/functions/v1

# Your AtlaSent organisation ID. Find it under Settings → Organisation.
ATLASENT_ORG_ID=org_replace_me

# Webhook URL for manufacturing system decision notifications (optional).
MFG_WEBHOOK_URL=https://your-mfg-system.example/webhooks
ATLASENT_WEBHOOK_SECRET=replace_me
