# AtlaSent environment variables for the VQP re-derivation demo.
# Copy to .env, fill in real values, and source before running.
#
# NEVER commit a .env file with real credentials to version control.

# Base URL for your Supabase project (e.g. https://<project-ref>.supabase.co).
# Offline stub: set to http://localhost:54321
ATLASENT_SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key — grants elevated privileges.
# SERVER-SIDE ONLY. Never expose this key in browser or client-side code.
# Offline stub: set to service_role_stub
ATLASENT_SUPABASE_SERVICE_ROLE_KEY=service_role_replace_me

# Your AtlaSent organisation ID. Find it under Settings → Organisation.
ATLASENT_ORG_ID=org_replace_me

# The VQP bundle ID to generate/verify snapshots for.
ATLASENT_BUNDLE_ID=bundle_replace_me
