{
  "action_type": "production.deploy",
  "description": "Salesforce/NetSuite business-system change gate (BSCM). Reuses production.deploy — no new action class. CAB approval + change window + approved deployer.",
  "allow_actors": ["github:acme-release-bot"],
  "rules": {
    "templates": [
      {
        "decision": "deny",
        "deny_code": "OUTSIDE_CHANGE_WINDOW",
        "when": { "field": "context.change_window", "eq": false }
      },
      {
        "decision": "deny",
        "deny_code": "INSUFFICIENT_APPROVALS",
        "require_approvals": 2,
        "when": { "field": "context.environment", "eq": "production" }
      },
      { "decision": "allow" }
    ]
  }
}
