# AtlaSent environment variables — vendor-payment-release quickstart
# Copy this file to .env, fill in real values, and source it before running.
#
# NEVER commit a .env file with real credentials to version control.

# Your AtlaSent API key. Create one in the console under Settings → API Keys.
ATLASENT_API_KEY=ask_replace_me

# Base URL for the AtlaSent API.
ATLASENT_API_URL=https://api.atlasent.io/functions/v1

# Your AtlaSent organisation ID. Find it under Settings → Organisation.
ATLASENT_ORG_ID=org_replace_me

# ── erp-webhook.ts only ────────────────────────────────────────────────────
# Signing secret for AtlaSent hold.approved webhook callbacks.
ATLASENT_WEBHOOK_SECRET=whsec_replace_me

# Signing secret for NetSuite webhook payloads (optional — set if using live NS).
NETSUITE_WEBHOOK_SECRET=ns_replace_me
