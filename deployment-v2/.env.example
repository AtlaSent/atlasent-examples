# AtlaSent environment variables for deployment V2 demo.
# Copy to .env, fill in real values, and source before running.
#
# NEVER commit a .env file with real credentials to version control.

ATLASENT_API_KEY=ask_replace_me
ATLASENT_API_URL=https://api.atlasent.io/functions/v1
ATLASENT_ORG_ID=org_replace_me

# Webhook URL for deployment decision notifications (optional).
DEPLOY_WEBHOOK_URL=https://your-deploy-system.example/webhooks
ATLASENT_WEBHOOK_SECRET=replace_me

# Change management ticket for production deploys (required by policy).
CHANGE_TICKET=CHG-replace_me

# Incident ID for rollback authorization (required by rollback policy).
INCIDENT_ID=INC-replace_me
